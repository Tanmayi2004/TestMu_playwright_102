{
  "name": "@lambdatest/playwright-node-sdk",
  "version": "1.0.5",
  "description": "LambdaTest Playwright Node SDK",
  "main": "dist/index.js",
  "bin": {
    "playwright-node-sdk": "./dist/index.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "rimraf dist && mkdir dist && javascript-obfuscator src --output dist --config obfuscator.config.json",
    "build:dev": "rimraf dist && mkdir dist && cp -r src/* dist/",
    "pack": "npm run build && npm pack --ignore-scripts",
    "pack:dev": "npm run build:dev && npm pack --ignore-scripts"
  },
  "keywords": [
    "playwright",
    "lambdatest",
    "testing",
    "automation"
  ],
  "author": "LambdaTest <keys@lambdatest.com>",
  "dependencies": {
    "@lambdatest/node-tunnel": "^4.0.9",
    "fs-extra": "^11.1.1",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "javascript-obfuscator": "^4.1.0",
    "rimraf": "^5.0.5"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
